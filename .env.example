NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Optional: enables a CAPTCHA on /submit-event to block bot submissions.
# Get keys at https://www.google.com/recaptcha/admin (choose reCAPTCHA v2,
# "I'm not a robot" Checkbox). Without these set, the form has no CAPTCHA
# and submissions aren't blocked on that basis.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
